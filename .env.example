# ============================================================
# Enterprise Decision Hub — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# JWT Secret — must be at least 32 characters, random
JWT_SECRET=your_strong_random_jwt_secret_here_minimum_32_chars
JWT_EXPIRATION=86400000

# MongoDB credentials (used in Docker deployment)
MONGO_ROOT_USERNAME=edh_admin
MONGO_ROOT_PASSWORD=your_strong_mongo_password_here
SPRING_DATA_MONGODB_URI=mongodb://edh_admin:your_strong_mongo_password_here@mongodb:27017/enterprise_decision_hub?authSource=admin

# ML Service
ML_RETRAIN_API_KEY=your_ml_api_key_here
ML_SERVICE_URL=http://ml-service:8000

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost
